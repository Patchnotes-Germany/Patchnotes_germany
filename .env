# Patchnotes — committed defaults. SAFE VALUES ONLY: real secrets belong in
#   .env.local        (development, read by Symfony Dotenv through the bind mount)
#   .env.prod.local   (production, passed to containers via env_file and --env-file)
# Docker Compose interpolation (${VAR}) reads this file and --env-file files only, never .env.local.
# See docs/operations.md and SPEC.md § 22 / § 24.20.

###> app ###
APP_ENV=dev
# Generated by "make install" (bin/console patchnotes:secrets:generate) into .env.local
APP_SECRET=ChangeThisAppSecretInEnvLocal
# Public hostname, also used in the crawler User-Agent
SERVER_NAME=localhost
DEFAULT_URI=https://localhost/
# libsodium secretbox key (base64, 32 bytes) for encrypted user profile tags — generated by "make install"
APP_ENCRYPTION_KEY=
# Host ports published by Docker Compose
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
###< app ###

###> database / search ###
# The database user name is fixed ("patchnotes"); the password is shared by compose and DATABASE_URL.
MYSQL_PASSWORD=patchnotes
MYSQL_ROOT_PASSWORD=root
DATABASE_URL="mysql://patchnotes:patchnotes@mysql:3306/patchnotes?serverVersion=8.4.11&charset=utf8mb4"
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=ChangeThisMeilisearchMasterKey
MEILI_ENV=development
# Dev-only host ports (bound to 127.0.0.1)
MYSQL_PORT=3306
MEILI_PORT=7700
MAILPIT_UI_PORT=8025
###< database / search ###

###> messenger / lock / workers ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
LOCK_DSN=${DATABASE_URL}
WORKER_AI_REPLICAS=2
###< messenger / lock / workers ###

###> mercure ###
MERCURE_URL=http://php/.well-known/mercure
MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< mercure ###

###> repositories (laws + content) ###
# forge: github | gitlab | gitea | none   ("none" = local branches and merges only, no API calls)
LAWS_REPO_URL=
LAWS_REPO_BRANCH=main
LAWS_REPO_FORGE=none
LAWS_REPO_FORGE_API_URL=
LAWS_REPO_PROJECT=
LAWS_REPO_TOKEN=
LAWS_REPO_SSH_KEY_PATH=
LAWS_REPO_WEBHOOK_SECRET=

CONTENT_REPO_URL=
CONTENT_REPO_BRANCH=main
CONTENT_REPO_FORGE=none
CONTENT_REPO_FORGE_API_URL=
CONTENT_REPO_PROJECT=
CONTENT_REPO_TOKEN=
CONTENT_REPO_SSH_KEY_PATH=
CONTENT_REPO_WEBHOOK_SECRET=

GIT_BOT_EMAIL=bot@patchnotes.local
# false in development: everything stays in the local clones, nothing is pushed
GIT_PUSH_ENABLED=false
# Extra known_hosts lines for self-hosted forges ("\n" separated); github/gitlab/codeberg are built in
GIT_KNOWN_HOSTS=
###< repositories (laws + content) ###

###> ai ###
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# e.g. http://host.docker.internal:11434/v1 (Ollama on the Docker host), http://host.docker.internal:1234/v1
# (LM Studio) or http://ollama:11434/v1 (local-llm profile). See docs/local-ai.md.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
# LM Studio and vLLM enforce a JSON schema; Ollama through /v1 does not. When false, invalid
# answers are validated and repaired by the application instead.
LOCAL_LLM_SUPPORTS_JSON_SCHEMA=true
# Format "provider:model-id"; providers: openai | anthropic | local
# e.g. AI_MODEL_LARGE=openai:gpt-5, AI_MODEL_MEDIUM=anthropic:claude-sonnet-5,
#      AI_MODEL_LOCAL=local:qwen/qwen3.8-27b
AI_MODEL_LARGE=
AI_MODEL_MEDIUM=
AI_MODEL_SMALL=
AI_MODEL_LOCAL=
AI_MONTHLY_BUDGET_EUR=50
AI_FX_USD_EUR=0.92
###< ai ###

###> sources ###
DIP_API_KEY=
# Contact address published in the crawler User-Agent (required by polite crawling rules)
CRAWLER_CONTACT_EMAIL=bot@patchnotes.local
###< sources ###

###> notifications ###
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@patchnotes.local
ADMIN_ALERT_EMAIL=admin@patchnotes.local
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_RU=
TELEGRAM_CHANNEL_UK=
TELEGRAM_CHANNEL_EN=
TELEGRAM_CHANNEL_TR=
TELEGRAM_ADMIN_CHAT_ID=
# Generated by "make install" (bin/console patchnotes:webpush:generate-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
###< notifications ###

###> legal (Impressum, § 5 DDG — required in prod) ###
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_EMAIL=
###< legal ###

###> optional ###
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
DONATION_URL=
# Remote AI worker (running on the owner's computer, see docs/local-ai.md)
AI_WORKER_SERVER_URL=
AI_WORKER_TOKEN=
###< optional ###

###> backup ###
BACKUP_TIME=04:30
BACKUP_RETENTION_DAYS=14
###< backup ###

