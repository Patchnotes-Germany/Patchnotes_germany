# editorconfig.org

root = true

[*]
charset = utf-8
insert_final_newline = true
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[**/{Dockerfile,Caddyfile,*.sh,Makefile}]
indent_style = tab

[{compose*.yaml,.github/**/*.yaml,.github/**/*.yml}]
indent_size = 2

[**.md]
indent_size = unset
indent_style = unset
trim_trailing_whitespace = false

[tests/Fixtures/**]
trim_trailing_whitespace = false
insert_final_newline = unset
