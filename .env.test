# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Webhook tests need a forge with a secret. Tests that touch real repositories build their own
# isolated configuration, so these values never point at anything real.
LAWS_REPO_FORGE=github
LAWS_REPO_PROJECT=org/laws
LAWS_REPO_WEBHOOK_SECRET=test-webhook-secret
CONTENT_REPO_FORGE=gitea
CONTENT_REPO_PROJECT=org/content
CONTENT_REPO_WEBHOOK_SECRET=test-webhook-secret
